{
  "name": "converge",
  "version": "0.1.0",
  "private": true,
  "description": "Understand AI-generated code while it is being built, not after it is finished.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "clients/*",
    "fixtures/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace converge-vscode",
    "package:vscode": "npm run package --workspace converge-vscode",
    "audit": "npm audit --audit-level=moderate",
    "licenses:check": "node ./scripts/check-licenses.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run licenses:check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
