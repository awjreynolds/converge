{
  "name": "converge-vscode",
  "displayName": "Converge",
  "description": "Understand AI-generated code while it is being built, not after it is finished.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "converge-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/awjreynolds/converge.git"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:converge.reasoning",
    "onCommand:converge.startSession",
    "onCommand:converge.openPanel"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pairing Sessions and diffs remain readable. Agent execution, workspace edits, tasks, and terminals are disabled.",
      "restrictedConfigurations": [
        "converge.provider",
        "converge.codexPath",
        "converge.claudePath",
        "converge.piPath"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "converge.startSession",
        "title": "Converge: Start Pairing Session"
      },
      {
        "command": "converge.openPanel",
        "title": "Converge: Open Reasoning Panel"
      }
    ],
    "configuration": {
      "title": "Converge",
      "properties": {
        "converge.provider": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "pi"
          ],
          "enumDescriptions": [
            "OpenAI Codex via its local app-server protocol.",
            "Anthropic Claude via the Claude Agent SDK. Authentication remains provider-owned.",
            "Pi via its local RPC protocol and Converge's packaged execution-approval gate. Authentication and model selection remain provider-owned."
          ],
          "default": "codex",
          "description": "Agent provider for new and resumed Pairing Sessions. Existing sessions must be resumed with their original provider."
        },
        "converge.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Absolute path or executable name for the Codex CLI."
        },
        "converge.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Absolute path or executable name for the supported Claude Code CLI."
        },
        "converge.piPath": {
          "type": "string",
          "default": "pi",
          "description": "Absolute path or executable name for the supported Pi CLI."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "converge",
          "title": "Converge",
          "icon": "media/converge.svg"
        }
      ]
    },
    "views": {
      "converge": [
        {
          "type": "webview",
          "id": "converge.reasoning",
          "name": "Reasoning"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "vitest run --root ../.. clients/vscode/src --exclude clients/vscode/src/test/**",
    "test:extension-host": "npm run build && node ./scripts/build-extension-host-tests.mjs && node ./scripts/run-extension-host-tests.mjs",
    "package": "npm run build && node ./scripts/verify-package-files.mjs && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@converge/claude": "*",
    "@converge/codex": "*",
    "@converge/core": "*",
    "@converge/pi": "*",
    "mermaid": "^11.16.1"
  },
  "files": [
    "dist/extension.cjs",
    "dist/pi-converge-extension.js",
    "dist/webview.js",
    "media/**",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "package.json"
  ]
}
